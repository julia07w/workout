# Neon Console -> Project -> Connect
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Neon Console -> Auth -> Configuration
NEON_AUTH_BASE_URL=https://YOUR-BRANCH.neonauth.YOUR-REGION.aws.neon.tech/neondb/auth

# Any cryptographically random string of at least 32 characters.
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters

